<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleDevelopmentRegion</key>
    <string>en</string>
    <key>CFBundleDisplayName</key>
    <string>WaifuClaw</string>
    <key>CFBundleIdentifier</key>
    <string>studio.phantomhorizons.waifuclaw.ios</string>
    <key>CFBundleShortVersionString</key>
    <string>1.0</string>
    <key>CFBundleVersion</key>
    <string>1</string>
    <key>LSRequiresIPhoneOS</key>
    <true/>
    <key>UILaunchScreen</key>
    <dict/>
    <key>UIRequiredDeviceCapabilities</key>
    <array>
        <string>arm64</string>
    </array>
    <key>UISupportedInterfaceOrientations</key>
    <array>
        <string>UIInterfaceOrientationPortrait</string>
    </array>
    <!-- Camera: QR pairing scan -->
    <key>NSCameraUsageDescription</key>
    <string>WaifuClaw uses the camera to scan the pairing QR code shown on your computer.</string>
    <!-- Local network: Bonjour discovery + talking to the desktop on LAN -->
    <key>NSLocalNetworkUsageDescription</key>
    <string>WaifuClaw looks for your computer on the local network so you can pair and chat with it.</string>
    <key>NSBonjourServices</key>
    <array>
        <string>_waifuclaw._tcp</string>
    </array>
    <!-- Face ID: app lock -->
    <key>NSFaceIDUsageDescription</key>
    <string>WaifuClaw uses Face ID to lock the app and keep your agent access private.</string>
</dict>
</plist>
